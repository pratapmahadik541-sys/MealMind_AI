# ==========================================
# MealMind.ai — Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Decision Engine, Demand Forecasting, ChefMind Assistant).
# In Google AI Studio, this is automatically injected at runtime.
# For local development or production, obtain your API key from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base URL where this application is hosted.
# Used for self-referential links, donation manifests, and API proxy routing.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: Environment mode ('development' or 'production')
NODE_ENV=development
